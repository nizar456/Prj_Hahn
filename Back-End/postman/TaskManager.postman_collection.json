{
  "info": {
    "name": "Task Manager API",
    "_postman_id": "b3d7f3f0-8c2b-4f1f-bc7d-task-manager-api",
    "description": "Collection Postman pour Auth (JWT), Projects et Tasks avec tests automatiques.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign-In (register)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {"raw": "{{baseUrl}}/api/auth/sign-in", "host": ["{{baseUrl}}"], "path": ["api","auth","sign-in"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"Password#123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Token présent', function () { pm.expect(json.token).to.exist; });",
                  "pm.environment.set('jwt', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"Password#123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Token présent', function () { pm.expect(json.token).to.exist; });",
                  "pm.environment.set('jwt', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwt}}"}
            ],
            "url": {"raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api","projects"]},
            "body": {"mode":"raw","raw":"{\n  \"title\": \"My Project\",\n  \"description\": \"Description\"\n}"}
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                "const json = pm.response.json();",
                "pm.environment.set('projectId', json.id);",
                "pm.test('Progress présent', function () { pm.expect(json).to.have.property('progress'); });"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{jwt}}"}],
            "url": {"raw":"{{baseUrl}}/api/projects","host":["{{baseUrl}}"],"path":["api","projects"]}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const arr = pm.response.json();",
              "pm.test('Array', function () { pm.expect(Array.isArray(arr)).to.be.true; });"
            ], "type":"text/javascript"}
          }]
        },
        {
          "name": "Get Project",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{jwt}}"}],
            "url": {"raw":"{{baseUrl}}/api/projects/{{projectId}}","host":["{{baseUrl}}"],"path":["api","projects","{{projectId}}"]}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Same project id', function () { pm.expect(json.id).to.eql(Number(pm.environment.get('projectId'))); });"
            ], "type":"text/javascript"}
          }]
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [
              {"key":"Content-Type","value":"application/json"},
              {"key":"Authorization","value":"Bearer {{jwt}}"}
            ],
            "url": {"raw":"{{baseUrl}}/api/projects/{{projectId}}","host":["{{baseUrl}}"],"path":["api","projects","{{projectId}}"]},
            "body": {"mode":"raw","raw":"{\n  \"title\": \"My Project Updated\",\n  \"description\": \"New Desc\"\n}"}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Title updated', function () { pm.expect(json.title).to.eql('My Project Updated'); });"
            ], "type":"text/javascript"}
          }]
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "header": [{"key":"Authorization","value":"Bearer {{jwt}}"}],
            "url": {"raw":"{{baseUrl}}/api/projects/{{projectId}}","host":["{{baseUrl}}"],"path":["api","projects","{{projectId}}"]}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 204', function () { pm.response.to.have.status(204); });"
            ], "type":"text/javascript"}
          }]
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {"key":"Content-Type","value":"application/json"},
              {"key":"Authorization","value":"Bearer {{jwt}}"}
            ],
            "url": {"raw":"{{baseUrl}}/api/projects/{{projectId}}/tasks","host":["{{baseUrl}}"],"path":["api","projects","{{projectId}}","tasks"]},
            "body": {"mode":"raw","raw":"{\n  \"title\": \"Task 1\",\n  \"description\": \"Do work\",\n  \"dueDate\": \"{{today}}\",\n  \"completed\": false\n}"}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.environment.set('taskId', json.id);",
              "pm.test('Completed false', function () { pm.expect(json.completed).to.eql(false); });"
            ], "type":"text/javascript"}
          }]
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{jwt}}"}],
            "url": {"raw":"{{baseUrl}}/api/projects/{{projectId}}/tasks","host":["{{baseUrl}}"],"path":["api","projects","{{projectId}}","tasks"]}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const arr = pm.response.json();",
              "pm.test('Array not empty', function () { pm.expect(arr.length).to.be.greaterThan(0); });"
            ], "type":"text/javascript"}
          }]
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "header": [{"key":"Authorization","value":"Bearer {{jwt}}"}],
            "url": {"raw":"{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}","host":["{{baseUrl}}"],"path":["api","projects","{{projectId}}","tasks","{{taskId}}"]}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Task id matches', function () { pm.expect(json.id).to.eql(Number(pm.environment.get('taskId'))); });"
            ], "type":"text/javascript"}
          }]
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              {"key":"Content-Type","value":"application/json"},
              {"key":"Authorization","value":"Bearer {{jwt}}"}
            ],
            "url": {"raw":"{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}","host":["{{baseUrl}}"],"path":["api","projects","{{projectId}}","tasks","{{taskId}}"]},
            "body": {"mode":"raw","raw":"{\n  \"title\": \"Task 1 updated\",\n  \"description\": \"Do work now\",\n  \"dueDate\": \"{{today}}\",\n  \"completed\": true\n}"}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Completed true', function () { pm.expect(json.completed).to.eql(true); });"
            ], "type":"text/javascript"}
          }]
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [{"key":"Authorization","value":"Bearer {{jwt}}"}],
            "url": {"raw":"{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}","host":["{{baseUrl}}"],"path":["api","projects","{{projectId}}","tasks","{{taskId}}"]}
          },
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('Status 204', function () { pm.response.to.have.status(204); });"
            ], "type":"text/javascript"}
          }]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Prépare la date du jour pour dueDate",
          "const now = new Date();",
          "const yyyy = now.getFullYear();",
          "const mm = String(now.getMonth()+1).padStart(2,'0');",
          "const dd = String(now.getDate()).padStart(2,'0');",
          "pm.environment.set('today', `${yyyy}-${mm}-${dd}`);"
        ]
      }
    }
  ]
}

